# Images
API_IMAGE=ghcr.io/theindex-training/theindex-api:main
FRONT_IMAGE=ghcr.io/theindex-training/theindex-front:main

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=theindex
DB_PASS=theindex
DB_NAME=theindex
DB_SYNC=true

# API
NODE_ENV=production
API_PORT=3000
PUBLIC_BASE_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200
# Production (VPS): CORS_ORIGIN=https://theindex.training,https://app.theindex.training
# until compose phase B, then https://app.theindex.training only.
# The media settings (MEDIA_STORAGE_DIR, MEDIA_PUBLIC_URL) are set in docker-compose.prod.yml,
# next to the volume they point at; don't add them here.

# Logging
LOG_LEVEL=debug
