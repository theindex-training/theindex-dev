# Images
API_IMAGE=ghcr.io/theindex-training/theindex-api:main
FRONT_IMAGE=ghcr.io/theindex-training/theindex-front:main
WEB_IMAGE=ghcr.io/theindex-training/theindex-web:main

# Database (docker-compose.dev.yml points the API container at the `db` service itself)
DB_HOST=localhost
DB_PORT=5432
DB_USER=theindex
DB_PASS=theindex
DB_NAME=theindex
DB_SYNC=true

# API
NODE_ENV=production
API_PORT=3000
PUBLIC_BASE_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200
# Production (VPS): CORS_ORIGIN=https://app.theindex.training (the portal; the public site
# calls the API server side, so it needs no CORS).
# The media settings (MEDIA_STORAGE_DIR, MEDIA_PUBLIC_URL, MEDIA_PRIVATE_STORAGE_DIR) are set in
# docker-compose.prod.yml, next to the volumes they point at; don't add them here.

# Auth (API). Required: the API doesn't start without JWT_SECRET. Production: a long random value,
# only in /opt/theindex/.env. docker-compose.dev.yml falls back to the development value below.
JWT_SECRET=dev-super-secret-change-me
# The ADMIN account the API creates on boot when no account has this email (skipped if either is
# empty). Production: a real email and a strong password.
SEED_ADMIN_EMAIL=admin
SEED_ADMIN_PASSWORD=admin

# Logging
LOG_LEVEL=debug
